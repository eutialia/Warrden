{
  // Declaration-only build of the design system's public entry (`src/ds.ts`).
  //
  // The app itself is bundled by Vite and never needs types on disk, but the
  // design-system export reads `.d.ts` to learn each component's props — that is
  // the contract the design agent codes against, so it is worth emitting properly
  // rather than leaving it to be inferred from source.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "allowImportingTsExtensions": false,
    "outDir": "./ds-dist/types",
    "rootDir": "./src",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.ds.tsbuildinfo"
  },
  // Only the entry: tsc still follows its imports, so everything the design system
  // actually exports gets types, without dragging in app-only files (`main.tsx`)
  // that rely on bundler-mode resolution.
  "include": ["src/ds.ts"]
}
